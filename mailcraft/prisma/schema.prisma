generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  DEPARTMENT
}

enum Brand {
  STAKES
  STAKES_CASINO
  X7
  X7_V2
}

enum Language {
  EN
  FR
  FRCA
  DE
  IT
  ES
}

enum ActivityAction {
  TEMPLATE_CLONED
  TEMPLATE_SAVED
  TEMPLATE_DELETED
  HTML_COPIED
  HTML_DOWNLOADED
  SECTION_DELETED
  ACCOUNT_CREATED
  ACCOUNT_DEACTIVATED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String? // null = Google-only account (no password login)
  role         Role    @default(DEPARTMENT)
  department   String?
  isActive     Boolean @default(true)
  canAccessEmails Boolean @default(true)
  // May add/edit/delete CTA presets (admins always can)
  canManageCtaPresets Boolean @default(false)

  savedTemplates        SavedTemplate[]  @relation("TemplateCreator")
  editedTemplates       SavedTemplate[]  @relation("TemplateLastEditor")
  templatesSharedByMe   SharedTemplate[] @relation("SharedBy")
  templatesSharedWithMe SharedTemplate[] @relation("SharedWith")
  activityLogs          ActivityLog[]
  folders               Folder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────
// MASTER TEMPLATE
// ─────────────────────────────────────────────

model MasterTemplate {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  brand        Brand
  description  String?

  // Base directory path on VPS filesystem
  // Per-language files: {baseFilePath}/{lang}.html
  // e.g. /var/www/mailcraft/master-templates/stakes/email-verification/en.html
  baseFilePath String

  isActive   Boolean @default(true)
  isImported Boolean @default(false)
  importedBy String?

  // JSON: TemplateFieldConfig[] — editable fields shown in editor
  editableFields Json

  // JSON: LockedFieldConfig[] — never shown to users, injected at render time
  lockedFields Json @default("[]")

  // JSON: Language[] — which language HTML files exist for this template
  // Controls language tabs in editor and which files to render/export
  languages Json @default("[]")

  savedTemplates SavedTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("master_templates")
}

// ─────────────────────────────────────────────
// SAVED TEMPLATE
// ─────────────────────────────────────────────

model SavedTemplate {
  id               String  @id @default(cuid())
  name             String
  // Creator. Nullable so deleting an account never deletes templates (SetNull).
  userId           String?
  masterTemplateId String

  // Owning department key (normalized, e.g. "CRM"). Set = shared by every account in
  // that department. Null = personal (admin / accounts without a department).
  department String?

  lastEditedById String?

  // JSON: MultiLanguageFieldValues — { en: { BANNER_URL: "...", ... }, fr: {...}, ... }
  fieldValues Json

  // JSON: SavedSectionConfig[] — section on/off state, same for all languages
  sectionConfig Json

  // JSON: CustomBlock[] — user-added blocks layered on top of the master (MailCraft Blocks).
  // Null = legacy template with no custom blocks (renders identically to before).
  customBlocks Json?

  // JSON: LayoutItem[] — interleaved order of master sections + custom blocks.
  // Null = legacy order: master sections in source order, no blocks.
  layoutOrder Json?

  // Base directory for rendered output files on VPS
  renderedBasePath String?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  sharedWith SharedTemplate[]

  user           User?          @relation("TemplateCreator", fields: [userId], references: [id], onDelete: SetNull)
  lastEditedBy   User?          @relation("TemplateLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  masterTemplate MasterTemplate @relation(fields: [masterTemplateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([department])
  @@index([masterTemplateId])
  @@map("saved_templates")
}

// ─────────────────────────────────────────────
// FOLDER
// ─────────────────────────────────────────────

model Folder {
  id     String  @id @default(cuid())
  name   String
  // Creator. Nullable so deleting an account never deletes folders (SetNull).
  userId String?
  // Owning department key — same semantics as SavedTemplate.department
  department String?

  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  templates SavedTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([department])
  @@map("folders")
}

// ─────────────────────────────────────────────
// SHARED TEMPLATE
// ─────────────────────────────────────────────

model SharedTemplate {
  id              String @id @default(cuid())
  savedTemplateId String
  sharedById      String
  sharedWithId    String

  savedTemplate SavedTemplate @relation(fields: [savedTemplateId], references: [id], onDelete: Cascade)
  sharedBy      User          @relation("SharedBy", fields: [sharedById], references: [id])
  sharedWith    User          @relation("SharedWith", fields: [sharedWithId], references: [id])

  createdAt DateTime @default(now())

  @@unique([savedTemplateId, sharedWithId])
  @@index([sharedWithId])
  @@index([sharedById])
  @@map("shared_templates")
}

// ─────────────────────────────────────────────
// CTA PRESET — dropdown options for the CTA Button Text field.
// One text per language; FRCA uses the FR text.
// ─────────────────────────────────────────────

model CtaPreset {
  id        String @id @default(cuid())
  en        String
  fr        String
  de        String
  it        String
  es        String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("cta_presets")
}

// ─────────────────────────────────────────────
// THUMBNAIL PRESET — quick picks for a template's thumbnail slots, per brand.
// kind 'card' fills THUMBn_* (all brands), kind 'icon' fills ICONn_* (X7 V2 Icons design).
// labels/sublabels/links are { en, fr, de, it, es } — FRCA uses FR.
// sublabels + links are optional (empty language = leave the template's value as is).
// ─────────────────────────────────────────────

model ThumbnailPreset {
  id        String @id @default(cuid())
  brand     Brand
  kind      String
  imageUrl  String
  labels    Json
  sublabels Json?
  links     Json?
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, kind, sortOrder])
  @@map("thumbnail_presets")
}

// ─────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────

model ActivityLog {
  id     String         @id @default(cuid())
  action ActivityAction
  userId String? // null once the account is deleted — userName keeps the record readable
  userName String

  savedTemplateId    String?
  savedTemplateName  String?
  masterTemplateName String?
  sectionName        String?
  htmlType           String?
  targetAccountName  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}
